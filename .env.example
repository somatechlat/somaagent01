# SomaStack Environment Configuration
# Copy to .env and customize

# ==========================================================================
# ENVIRONMENT
# ==========================================================================
ENVIRONMENT=development

# ==========================================================================
# DATABASE
# ==========================================================================
POSTGRES_USER=postgres
# POSTGRES_PASSWORD is read from Vault at runtime:
#   secret/agent/credentials/postgres_password
POSTGRES_PORT=5432

# ==========================================================================
# CACHE
# ==========================================================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ==========================================================================
# MESSAGE BROKER
# ==========================================================================
KAFKA_PORT=9092

# ==========================================================================
# VECTOR DATABASE
# ==========================================================================
MILVUS_PORT=19530

# ==========================================================================
# AUTHORIZATION
# ==========================================================================
# SPICEDB_TOKEN is read from Vault at runtime: secret/agent/credentials/spicedb_token
# ==========================================================================
# JWT / AUTH
# ==========================================================================
# JWT_SECRET is read from Vault at runtime: secret/agent/credentials/jwt_secret
# ==========================================================================
# SOMAAGENT01 REQUIRED ENVIRONMENT VARIABLES
# (These are required by services/gateway/settings.py on startup)
# ==========================================================================
# SA01_DB_DSN is deliberately absent — a DSN embeds the password. Read the
# password from Vault (secret/agent/credentials/postgres_password) and build the
# DSN from host/port/user/db. No DSNs in ENV.
SA01_REDIS_URL=redis://localhost:6379
SA01_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SA01_SOMA_BASE_URL=http://localhost:8000
SA01_OPA_URL=http://localhost:8181/v1/data/soma
SA01_KEYCLOAK_URL=http://localhost:8080
# SA01_JWT_SECRET is read from Vault at runtime: secret/agent/credentials/jwt_secret
SA01_ALLOWED_HOSTS=localhost,127.0.0.1,*
SA01_AUTH_REQUIRED=true

# ==========================================================================
# LLM PROVIDERS — KEYS ARE NOT ENVIRONMENT VARIABLES
# ==========================================================================
# The agent has full model administration:
#   * LLMModelConfig (Django admin) selects model + provider
#   * Vault secret/agent/api_keys/{provider}_api_key holds the key
#     (UnifiedSecretManager.get_provider_key, fail-closed)
#
# Seed one:
#   vault kv put secret/agent/api_keys groq_api_key='<real key>'
#
# There is deliberately no OPENAI_API_KEY / GROQ_API_KEY / ANTHROPIC_API_KEY
# here. Adding one creates a second source of truth the runtime never reads.

# ==========================================================================
# CONFIDENCE SCORING
# ==========================================================================
CONFIDENCE_ENABLED=true
CONFIDENCE_AGGREGATION=average

# ==========================================================================
# GOOGLE OAUTH (for SSO)
# ==========================================================================
# GOOGLE_CLIENT_ID is not a secret (public OAuth client id) — set it for your project.
# GOOGLE_CLIENT_SECRET is read from Vault at runtime:
#   secret/agent/credentials/google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
