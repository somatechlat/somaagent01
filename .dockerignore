# Build context exclusions.
# Anything here never reaches an image layer. Rule 164: a secret is Vault
# material and must not be baked into an image, a layer, or a cache.

# --- secret MATERIAL (naming the directories, not name substrings) ----------
# `admin/secrets/` is a Django APP (api.py, __init__.py) -- source code, kept.
# These are the directories that hold t=0 credentials.
infra/standalone/secrets/
infra/aaas/secrets/
**/vault_root_token
**/vault_unseal_key
**/*_vault_root_token
**/*_vault_unseal_key

# --- env files at every depth ----------------------------------------------
# A bare `.env` matches only the repo root; `infra/standalone/.env` and
# `admin/.env` are real files here and were NOT excluded before.
**/.env
**/.env.*
!**/.env.example

# --- key and certificate FORMATS (safe: real code is .py) -------------------
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ecdsa*
id_ed25519*

# --- VCS / CI ---------------------------------------------------------------
.git
.github
.gitignore

# --- Python -----------------------------------------------------------------
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.hypothesis
.benchmarks

# --- virtualenvs ------------------------------------------------------------
env
venv
.venv

# --- Node -------------------------------------------------------------------
node_modules
dist
build
.next
.vite

# --- IDE / OS ---------------------------------------------------------------
.idea
.vscode
.DS_Store

# --- test / run artifacts ---------------------------------------------------
tmp
test-results
playwright-report
blob-report
.playwright
*.log
data

# --- docs not needed at runtime ---------------------------------------------
docs
*.md
!README.md
