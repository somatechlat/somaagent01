# ═══════════════════════════════════════════════════════════════════════════════
# SOMAAGENT01 STANDALONE DEPLOYMENT - ENVIRONMENT TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════════
# VIBE Rule 100: This is the SINGLE SOURCE OF TRUTH for Standalone configuration
# VIBE Rule 91: No localhost fallbacks - all URLs explicitly configured
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT MODE (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────────
SA01_DEPLOYMENT_MODE=STANDALONE
SA01_DEPLOYMENT_TARGET=LOCAL
DJANGO_DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────────
# VAULT CONFIGURATION (VIBE Rule 164: All secrets from Vault)
# ─────────────────────────────────────────────────────────────────────────────────
VAULT_ADDR=http://somaagent_vault:8200
VAULT_MOUNT=secret
VAULT_PATH_PREFIX=somaagent
# VAULT_DEV_ROOT_TOKEN_ID and VAULT_TOKEN are NEVER set here. Root exists only
# for the unseal/policy one-shots (vault_unseal.py / vault_scoped_tokens.py)
# in the T0_DIR RAM custodian. A value in this file would be a credential in git.
# Scoped runtime token lease for vault_scoped_tokens.py. Required operator
# policy — no default in code (Rule 91). App/tests hold agent_runtime_token only.
VAULT_TOKEN_TTL_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────────
# DATABASE (Port 20432)
# ─────────────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=somaagent_postgres
POSTGRES_PORT=5432
POSTGRES_DB=somaagent
POSTGRES_USER=somaagent
# POSTGRES_PASSWORD and SA01_DB_DSN are deliberately absent — a DSN embeds the
# password. Read it from Vault at runtime (secret/agent/credentials/postgres_password)
# and build the DSN from the topology above. No passwords and no DSNs in ENV.

# ─────────────────────────────────────────────────────────────────────────────────
# REDIS CACHE (Port 20379)
# ─────────────────────────────────────────────────────────────────────────────────
REDIS_HOST=somaagent_redis
REDIS_PORT=6379
REDIS_DB=0
SA01_REDIS_URL=redis://somaagent_redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────────
# KEYCLOAK IDENTITY (Port 20880)
# ─────────────────────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://somaagent_keycloak:8080
KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD is read from Vault at runtime:
#   secret/agent/credentials/keycloak_admin_password
KEYCLOAK_REALM=somaagent
KEYCLOAK_CLIENT_ID=somaagent-api
# KEYCLOAK_CLIENT_SECRET loaded from Vault
SA01_KEYCLOAK_URL=http://somaagent_keycloak:8080

# ─────────────────────────────────────────────────────────────────────────────────
# AGENT API SETTINGS
# ─────────────────────────────────────────────────────────────────────────────────
SAGENTA_HOST=0.0.0.0
SAGENTA_PORT=9000
SA01_ALLOWED_HOSTS=*

# ─────────────────────────────────────────────────────────────────────────────────
# LLM / MODEL ADMINISTRATION — NOT ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────────
# Model CREDENTIALS do not live here. There is no GROQ_API_KEY or OPENAI_API_KEY
# in this file on purpose. The agent has full model administration:
#
#   * LLMModelConfig  (Django admin)  — selects model + provider
#   * Vault           secret/agent/api_keys/{provider}_api_key — the key
#     read by UnifiedSecretManager.get_provider_key() (fail-closed)
#
# Seed a key:
#   vault kv put secret/agent/api_keys groq_api_key='<real key>'
#
# Model POINTER (not a credential) — override only if needed:
# SA01_DEFAULT_CHAT_MODEL=

# AAAS default tenant — REQUIRED, docker-compose fails closed if unset.
# Deployment config, not a secret.
SA01_DEFAULT_TENANT_ID=cb6fc5b8-9525-4e81-8b6d-8ccf86460e9c

# ─────────────────────────────────────────────────────────────────────────────────
# OPTIONAL EXTERNAL SERVICES (Standalone mode — left empty)
# ─────────────────────────────────────────────────────────────────────────────────
SA01_OPA_URL=
SA01_KAFKA_BOOTSTRAP_SERVERS=

# ─────────────────────────────────────────────────────────────────────────────────
# STANDALONE MODE - NO BRAIN/MEMORY DEPENDENCIES
# ─────────────────────────────────────────────────────────────────────────────────
# SomaBrain and FractalMemory are NOT available in Standalone mode
# Cognitive features will be disabled or use fallback implementations
SOMABRAIN_ENABLED=false
FRACTALMEMORY_ENABLED=false
